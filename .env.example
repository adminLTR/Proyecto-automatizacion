# Environment variables for the Telegram Automation Bot

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BASE_URL=https://api.telegram.org/bot

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your_secret_key_here_change_in_production

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=5000

# Google API Configuration
# You need to download credentials.json from Google Cloud Console
# Place it in the root directory of the project
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# Email Configuration
DEFAULT_EMAIL_RECIPIENT=default@example.com
EMAIL_DELETE_DAYS_AGO=7

# Calendar Configuration
CALENDAR_TIMEZONE=America/Lima

# Webhook Configuration (if using webhooks instead of polling)
WEBHOOK_URL=https://your-ngrok-or-domain.com/webhook
USE_WEBHOOK=False

# Logging
LOG_LEVEL=INFO
