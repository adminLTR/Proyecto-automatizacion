# ========================================
# Configuración del Bot de Telegram
# ========================================

# Token del bot (obtenlo de @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=tu_token_aqui

# ========================================
# Configuración de Email
# ========================================

# Email por defecto para enviar mensajes (comando 111)
DEFAULT_EMAIL_RECIPIENT=tu-email@ejemplo.com

# ========================================
# Configuración de Google Calendar
# ========================================

# Zona horaria para eventos del calendario
CALENDAR_TIMEZONE=America/Lima

# ========================================
# Configuración de Google APIs
# ========================================

# Ruta al archivo de credenciales de Google Cloud
GOOGLE_CREDENTIALS_PATH=credentials.json

# Ruta donde se guardará el token de autenticación
GOOGLE_TOKEN_PATH=token.json

# ========================================
# Configuración del Servidor Flask
# ========================================

# Host del servidor (0.0.0.0 para acceso desde cualquier IP)
APP_HOST=0.0.0.0

# Puerto del servidor
APP_PORT=5000

# Clave secreta de Flask (cambia esto en producción)
SECRET_KEY=cambia-esto-en-produccion

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
